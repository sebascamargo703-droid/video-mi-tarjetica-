{
  "name": "multinicho",
  "version": "1.0.0",
  "description": "Mi Tarjetica — 'Una tarjeta para cada negocio' (MultiNicho / MultiNichoFeed), sincronizado al beat",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc --noEmit",
    "audio": "python3 scripts/make-audio.py",
    "render:vertical": "remotion render MultiNicho out/multinicho-vertical.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:feed": "remotion render MultiNichoFeed out/multinicho-feed.mp4 --codec=h264 --crf=16 --audio-bitrate=192k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
