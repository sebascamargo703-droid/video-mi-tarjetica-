{
  "name": "mi-tarjetica-launch",
  "version": "1.0.0",
  "description": "Mi Tarjetica — video de lanzamiento (keynote) + historias y publicaciones para redes",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc --noEmit",
    "render:hero": "remotion render MiTarjeticaHero ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/video-horizontal-16x9.mp4 --codec=h264 --crf=18 --audio-bitrate=192k && bash scripts/master-audio.sh ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/video-horizontal-16x9.mp4",
    "render:vertical": "remotion render MiTarjeticaVertical ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/reel-vertical-9x16.mp4 --codec=h264 --crf=18 --audio-bitrate=192k && bash scripts/master-audio.sh ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/reel-vertical-9x16.mp4",
    "render:hero:4k": "remotion render MiTarjeticaHero ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/video-horizontal-4k.mp4 --scale=2 --codec=h264 --crf=18 --audio-bitrate=192k && bash scripts/master-audio.sh ../PUBLICACIONES-MI-TARJETICA/01-video-lanzamiento/video-horizontal-4k.mp4",
    "render:social": "node scripts/render-social.mjs",
    "voice": "python3 scripts/make-voice.py --models .",
    "music": "python3 scripts/make-music.py && remotion ffmpeg -y -i public/music/cama.wav -b:a 192k public/music/cama.mp3 && rm public/music/cama.wav"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
