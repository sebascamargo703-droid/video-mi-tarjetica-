{
  "name": "mi-tarjetica-launch",
  "version": "1.0.0",
  "description": "Mi Tarjetica — video de lanzamiento (keynote) + historias y publicaciones para redes",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsc --noEmit",
    "render:hero": "remotion render MiTarjeticaHero out/mi-tarjetica-hero.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render MiTarjeticaVertical out/mi-tarjetica-vertical.mp4 --codec=h264 --crf=18",
    "render:hero:4k": "remotion render MiTarjeticaHero out/mi-tarjetica-hero-4k.mp4 --scale=2 --codec=h264 --crf=18",
    "render:social": "node scripts/render-social.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
